    },
    {
      "name": "Billing",
      "description": "Tenant-scoped. POST /invoices computes all pricing/tax/discount server-side from product_id/variant_id + quantity - never send a price. Passing the same idempotency_key twice returns the original invoice instead of creating a duplicate.",
      "item": [
        {
          "name": "Create Invoice (walk-in, cash)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-business-id", "value": "{{business_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"product_id\": \"{{product_id}}\", \"quantity\": 2 }\n  ],\n  \"payments\": [\n    { \"method\": \"cash\", \"amount\": \"220.00\" }\n  ],\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/invoices", "host": ["{{base_url}}"], "path": ["invoices"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('invoice_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Invoice (registered customer, with discount + partial payment)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-business-id", "value": "{{business_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"items\": [\n    { \"product_id\": \"{{product_id}}\", \"quantity\": 3, \"discount_amount\": \"10.00\" }\n  ],\n  \"payments\": [\n    { \"method\": \"upi\", \"amount\": \"100.00\", \"reference\": \"UPI-REF-001\" }\n  ],\n  \"notes\": \"Loyal customer\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/invoices", "host": ["{{base_url}}"], "path": ["invoices"] }
          }
        },
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
              "raw": "{{base_url}}/invoices?page=1&page_size=25",
              "host": ["{{base_url}}"],
              "path": ["invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "Show Invoice",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}",
              "host": ["{{base_url}}"],
              "path": ["invoices", "{{invoice_id}}"]
            }
          }
        },
        {
          "name": "Record Additional Payment (settle a partial/credit sale)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-business-id", "value": "{{business_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment\": {\n    \"method\": \"cash\",\n    \"amount\": \"50.00\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}/payments",
              "host": ["{{base_url}}"],
              "path": ["invoices", "{{invoice_id}}", "payments"]
            }
          }
        },
        {
          "name": "Cancel / Void Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["invoices", "{{invoice_id}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "description": "Tenant-scoped, read-only. from/to are inclusive YYYY-MM-DD dates in the business's own timezone.",
      "item": [
        {
          "name": "Sales Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
              "raw": "{{base_url}}/reports/sales_summary?from={{$isoTimestamp}}&to={{$isoTimestamp}}",
              "host": ["{{base_url}}"],
              "path": ["reports", "sales_summary"],
              "query": [
                { "key": "from", "value": "{{$isoTimestamp}}", "description": "e.g. 2026-09-01" },
                { "key": "to", "value": "{{$isoTimestamp}}", "description": "e.g. 2026-09-23" }
              ]
            }
          }
        },
        {
          "name": "Daily Sales (dashboard trend)",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
              "raw": "{{base_url}}/reports/daily_sales?from={{$isoTimestamp}}&to={{$isoTimestamp}}",
              "host": ["{{base_url}}"],
              "path": ["reports", "daily_sales"],
              "query": [
                { "key": "from", "value": "{{$isoTimestamp}}", "description": "e.g. 2026-09-17" },
                { "key": "to", "value": "{{$isoTimestamp}}", "description": "e.g. 2026-09-23" }
              ]
            }
          }
        },
        {
          "name": "Top Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
              "raw": "{{base_url}}/reports/top_products?from={{$isoTimestamp}}&to={{$isoTimestamp}}&limit=10",
              "host": ["{{base_url}}"],
              "path": ["reports", "top_products"],
              "query": [
                { "key": "from", "value": "{{$isoTimestamp}}" },
                { "key": "to", "value": "{{$isoTimestamp}}" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Current Stock",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
              "raw": "{{base_url}}/reports/stock",
              "host": ["{{base_url}}"],
              "path": ["reports", "stock"]
            }
          }
        },
        {
          "name": "Low Stock Only",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-business-id", "value": "{{business_id}}" }],
            "url": {
